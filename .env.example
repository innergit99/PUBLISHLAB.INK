# ============================================================
# PUBLISH LAB — ENVIRONMENT CONFIGURATION
# Last updated: 2026-08-12
# ============================================================
#
# LOCAL DEV MODE (auto-detected when Ollama running):
#   - Text: Ollama (localhost:11434) → llama3.2:3b
#   - Images: Canvas (client-side, zero cost)
#   - Cost: $0/month
#
# PRODUCTION MODE (auto-detected on Vercel):
#   - Text: Gemini 2.5 Flash → Groq → HF fallback
#   - Images: Pollinations → Canvas fallback
#   - Cost: ~$2-5/user/month at scale
#
# DEPLOY: Set these in Vercel → Project → Settings → Environment Variables
# ============================================================

# --- FORCE FLAGS (dev testing only) ---
# VITE_FORCE_LOCAL_MODE=true
# VITE_FORCE_PRODUCTION_MODE=true

# --- TEXT INTELLIGENCE (Primary) ---
# Gemini 2.5 Flash — GA stable, fastest quality model as of mid-2026
# Get key: https://aistudio.google.com/app/apikey
# ACTIVE MODELS: gemini-2.5-flash, gemini-2.5-pro, gemini-2.5-flash-lite
# RETIRED (return 404): gemini-1.0-pro, gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# --- TEXT FALLBACK (High Quality) ---
# Groq Llama 3.3-70B — free tier available, very fast
# Get key: https://console.groq.com
VITE_GROQ_API_KEY=your_groq_api_key_here

# --- TEXT BACKUP (Last Resort) ---
# HuggingFace — slow but free
VITE_HF_API_TOKEN=your_hf_token_here

# --- IMAGE GENERATION ---
# Fal.ai Flux Schnell — highest quality AI images
# Get key: https://fal.ai
# If not set, falls back to Pollinations (free, rate-limited) → Canvas
VITE_FAL_API_KEY=your_fal_api_key_here

# --- PAYMENT PROCESSING (PRODUCTION) ---
# Paddle Billing v2 — Live production (Seller ID: 281327)
# ⚠️  NEVER set VITE_PADDLE_ENVIRONMENT=sandbox in production .env
# Client token from: vendors.paddle.com → Developer Tools → Client-side tokens
VITE_PADDLE_VENDOR_ID=281327
VITE_PADDLE_CLIENT_TOKEN=your_paddle_client_token_here
VITE_PADDLE_ENVIRONMENT=production

# --- DATABASE & AUTH ---
# Supabase — user accounts, usage tracking, content storage
# Project ID: mctmtdjbjynzlunfictm
# Keys from: supabase.com/dashboard → Settings → API
VITE_SUPABASE_URL=https://mctmtdjbjynzlunfictm.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- ANALYTICS ---
# PostHog — free tier (1M events/mo), signup at posthog.com
# Key from: posthog.com → Project Settings → Project API Key
VITE_POSTHOG_KEY=your_posthog_project_api_key_here
VITE_POSTHOG_HOST=https://app.posthog.com

# --- SERVER-SIDE (Vercel env vars only — never expose client-side) ---
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- MARKET INTELLIGENCE (Optional) ---
# Firecrawl — live Amazon BSR + web scraping for Trend Radar
# VITE_FIRECRAWL_API_KEY=your_firecrawl_key_here
